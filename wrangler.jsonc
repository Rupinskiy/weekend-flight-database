{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "weekend-flight-database",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/webhooks/*"]
  },
  "d1_databases": [
    {"binding": "DB", "database_name": "weekend-flight-database", "database_id": "REPLACE_WITH_YOUR_CLOUDFLARE_D1_DATABASE_ID"}
  ],
  "triggers": {"crons": ["*/15 * * * *"]},
  "observability": {"enabled": true}
}
