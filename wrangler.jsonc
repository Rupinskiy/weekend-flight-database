{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "weekend-flight-database",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/webhooks/*"]
  },
  "d1_databases": [
    {"binding": "DB", "database_name": "weekend-flight-database", "database_id": "d7e6287b-9bea-4e38-ae2f-2e5b3a8f7242"}
  ],
  "triggers": {"crons": ["*/15 * * * *"]},
  "observability": {"enabled": true}
}
